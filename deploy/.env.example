# TestFleet configuration. Copy to .env and fill in; never commit .env.

# --- Required ---------------------------------------------------------------

# The public host name, as the reverse proxy serves it (https, port 443)
PHX_HOST=testfleet.example.internal

# openssl rand -base64 48
SECRET_KEY_BASE=

# openssl rand -base64 32
# Encrypts environment variables, registry passwords, and notification URLs.
# BACK IT UP WITH THE DATABASE: without it, those secrets are unreadable.
CLOAK_KEY=

# openssl rand -hex 24 (URL-safe: it becomes part of DATABASE_URL)
POSTGRES_PASSWORD=

# --- Deployment -------------------------------------------------------------

# The image to run. Built from this repository by default.
# TESTFLEET_IMAGE=testfleet:latest

# Where the port is published. The default suits a reverse proxy on this host.
# TESTFLEET_PUBLISH=127.0.0.1:4000

# --- Execution --------------------------------------------------------------

# Runs executing at the same time, across all environments
# MAX_CONCURRENT_RUNS=10

# PULL_TIMEOUT_SECONDS=600
# RUN_LOG_LIMIT_MB=50
# ARTIFACT_LIMIT_MB=500

# --- Retention --------------------------------------------------------------

# ARTIFACT_RETENTION_DAYS=30
# LOG_RETENTION_DAYS=90
# IMAGE_RETENTION_DAYS=7

# --- Notifications ----------------------------------------------------------

# Email channels send nothing without SMTP_HOST.
# SMTP_HOST=smtp.example.internal
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=if_available
# SMTP_FROM=testfleet@example.internal

# An external dead man's switch, pinged after each schedule tick
# HEARTBEAT_URL=

# --- Database ---------------------------------------------------------------

# POOL_SIZE=10
