---
import HeroIcon from './HeroIcon.astro';
import { withBase } from '../../lib/links';

const features = [
	{
		icon: 'calendar-days',
		title: 'Schedules that keep time',
		text: 'Cron in the time zone you mean, daylight saving handled, missed slots coalesced, and an overlap policy for slow suites.',
		href: '/guides/schedules/',
	},
	{
		icon: 'command-line',
		title: 'Live output',
		text: 'Follow the suite line by line in the browser. Every line is stored, so the log is still there tomorrow.',
		href: '/guides/runs/',
	},
	{
		icon: 'shield-check',
		title: 'Secrets stay secret',
		text: 'Variables are encrypted at rest, never sent back to the browser, and masked in the log before it is stored.',
		href: '/guides/environments/',
	},
	{
		icon: 'chart-bar',
		title: 'Results and artifacts',
		text: 'JUnit XML becomes per-test results. Screenshots, videos, traces, and HTML reports are kept with the run.',
		href: '/suites/results-and-artifacts/',
	},
	{
		icon: 'bell-alert',
		title: 'Alerts on change',
		text: 'Email, Slack, Teams, or a signed webhook when a suite starts failing or recovers, not on every red run.',
		href: '/guides/notifications/',
	},
	{
		icon: 'cpu-chip',
		title: 'Limits that protect',
		text: 'Timeouts, CPU and memory limits, and concurrency per environment, so a suite never floods production.',
		href: '/guides/test-definitions/',
	},
	{
		icon: 'code-bracket-square',
		title: 'Built for pipelines',
		text: 'Set the image tag, start a run, stream its log, and fail the build from CI, with one script.',
		href: '/ci/pipelines/',
	},
	{
		icon: 'arrow-path',
		title: 'Survives restarts',
		text: 'Suites run in their own containers. When TestFleet restarts, it picks them up again, deadline and all.',
		href: '/internals/execution/',
	},
] as const;
---

<section class="tf-features not-content" aria-label="Features">
	{
		features.map((feature) => (
			<a class="card" href={withBase(feature.href)}>
				<span class="icon">
					<HeroIcon name={feature.icon} />
				</span>
				<h3>{feature.title}</h3>
				<p>{feature.text}</p>
			</a>
		))
	}
</section>

<style>
	.tf-features {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1rem;
		padding-bottom: clamp(2.5rem, 2rem + 4vw, 5rem);
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.25rem;
		border: 1px solid var(--tf-border);
		border-radius: 0.9rem;
		background: var(--tf-surface);
		color: inherit;
		text-decoration: none;
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
		box-shadow: 0 14px 30px -18px var(--tf-glow);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.65rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		transition: transform 180ms ease;
	}

	:root[data-theme='light'] .icon {
		color: var(--sl-color-accent);
	}

	.card:hover .icon {
		transform: rotate(-6deg);
	}

	.icon :global(svg) {
		width: 1.35rem;
		height: 1.35rem;
	}

	h3 {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}

	p {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.icon {
			transition: none;
		}
	}
</style>
